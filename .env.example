# Name of the GCS bucket weather files are stored in.
GCS_BUCKET_NAME=your-bucket-name-here

# Comma-separated list of allowed frontend origins, or "*" for any (dev only).
ALLOWED_ORIGINS=*

# Only needed for LOCAL runs if you're not using `gcloud auth application-default login`.
# Path to a service account JSON key with Storage Object Admin on the bucket.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
